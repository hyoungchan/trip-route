NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 서버 전용 (NEXT_PUBLIC_ 사용 금지)
# NAVER Cloud Console > Application Services > NAVER API HUB Application 인증 정보
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 서버 전용 Google Maps Platform Routes API 키 (NEXT_PUBLIC_ 사용 금지)
GOOGLE_MAPS_API_KEY=

# 서버 전용 네이버 Directions 5 (Maps 애플리케이션 Client Secret)
# Client ID는 NEXT_PUBLIC_NAVER_MAP_CLIENT_ID와 동일한 Maps 앱을 사용합니다.
NAVER_MAP_CLIENT_SECRET=
